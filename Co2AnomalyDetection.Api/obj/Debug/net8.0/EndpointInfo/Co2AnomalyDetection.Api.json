{
  "openapi": "3.0.1",
  "info": {
    "title": "Co2AnomalyDetection.Api",
    "version": "1.0"
  },
  "paths": {
    "/api/emissions/analyze-advanced": {
      "post": {
        "tags": [
          "Co2AnomalyDetection.Api"
        ],
        "operationId": "AnalyzeEmissionsAdvanced",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmissionRecord"
            },
            "nullable": true
          },
          "operationalContexts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperationalContext"
            },
            "nullable": true
          },
          "enableAiAssistance": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "EmissionRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "site": {
            "type": "string",
            "nullable": true
          },
          "month": {
            "type": "string",
            "nullable": true
          },
          "energyKwh": {
            "type": "number",
            "format": "double"
          },
          "co2Kg": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "OperationalContext": {
        "type": "object",
        "properties": {
          "site": {
            "type": "string",
            "nullable": true
          },
          "month": {
            "type": "string",
            "nullable": true
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "expectedEnergyMultiplier": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      }
    }
  }
}